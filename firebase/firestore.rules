rules_version = '2';

// Règles de sécurité (voir CLAUDE.md, sections 5 et 6 : données sensibles).
// Tout ce qui n'est pas explicitement autorisé est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function moi() {
      return request.auth.uid;
    }

    // Rôle coach : custom claim attribué par une Cloud Function, jamais par l'app.
    function estCoach() {
      return connecte() && request.auth.token.coach == true;
    }

    function texte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // ----- Profils -----
    match /users/{uid} {
      allow read: if (connecte() && uid == moi()) || estCoach();

      // Création : consentement explicite daté par le serveur.
      allow create: if connecte() && uid == moi()
        && request.resource.data.keys().hasOnly([
          'nom', 'email', 'langue', 'parcours', 'consentementLe', 'createdAt'])
        && texte(request.resource.data.nom, 100)
        && request.resource.data.langue in ['fr', 'en', 'pt', 'es', 'nl']
        && request.resource.data.parcours in ['couple', 'seul', 'decouverte']
        && request.resource.data.consentementLe == request.time;

      // Modification : nom, langue et parcours seulement.
      allow update: if connecte() && uid == moi()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nom', 'langue', 'parcours', 'photoUrl', 'jetonsNotif', 'decalageMin'])
        && (request.resource.data.get('decalageMin', 0) is int
          && request.resource.data.get('decalageMin', 0) >= -720
          && request.resource.data.get('decalageMin', 0) <= 840)
        && request.resource.data.get('jetonsNotif', []) is list
        && request.resource.data.get('jetonsNotif', []).size() <= 20
        && (request.resource.data.get('photoUrl', null) == null
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.matches('https://.+')
            && request.resource.data.photoUrl.size() <= 1000))
        && texte(request.resource.data.nom, 100)
        && request.resource.data.langue in ['fr', 'en', 'pt', 'es', 'nl']
        && request.resource.data.parcours in ['couple', 'seul', 'decouverte'];

      allow delete: if connecte() && uid == moi();

      // Progression dans les parcours : chacun la sienne (le coach la lit).
      match /progression/{parcoursId} {
        allow read: if (connecte() && uid == moi()) || estCoach();
        allow write: if connecte() && uid == moi()
          && request.resource.data.keys().hasOnly(['faits', 'updatedAt'])
          && request.resource.data.faits is list
          && request.resource.data.faits.size() <= 500;
      }
    }

    // ----- Accompagnements -----
    function champs() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /accompagnements/{id} {
      allow read: if estCoach()
        || (connecte() && moi() in resource.data.membres);

      // Demande : seul membre = soi ; un couple crée son code d'invitation
      // dans le même envoi. Séances et statut : réservés au coach.
      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
          'type', 'nom', 'membres', 'noms', 'codeInvitation', 'statut',
          'message', 'createdAt', 'updatedAt'])
        && request.resource.data.membres == [moi()]
        && request.resource.data.noms.keys().hasOnly([moi()])
        && request.resource.data.statut == 'demande'
        && texte(request.resource.data.nom, 80)
        && request.resource.data.get('message', '').size() <= 2000
        && (
          (request.resource.data.type == 'individuel'
            && !('codeInvitation' in request.resource.data))
          || (request.resource.data.type == 'couple'
            && request.resource.data.codeInvitation is string
            && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.codeInvitation))
                 .data.accompagnementId == id)
        );

      // Le conjoint rejoint un couple incomplet en donnant le bon code.
      allow update: if connecte()
        && resource.data.type == 'couple'
        && resource.data.membres.size() == 1
        && !(moi() in resource.data.membres)
        && request.resource.data.codeUtilise == resource.data.codeInvitation
        && request.resource.data.membres == resource.data.membres.concat([moi()])
        && request.resource.data.noms.diff(resource.data.noms).affectedKeys().hasOnly([moi()])
        && champs().hasOnly(['membres', 'noms', 'codeUtilise', 'updatedAt']);

      // Messagerie : un membre met à jour l'aperçu, les non-lus du coach et
      // remet à zéro ses propres non-lus (jamais ceux de son conjoint).
      allow update: if connecte() && moi() in resource.data.membres
        && champs().hasOnly(['dernierMessage', 'dernierMessageLe', 'nonLusCoach', 'nonLus'])
        && (!('nonLus' in champs())
          || request.resource.data.nonLus.diff(resource.data.get('nonLus', {}))
               .affectedKeys().hasOnly([moi()]))
        && request.resource.data.get('nonLusCoach', 0) is int;

      // Le coach gère le statut, les séances restantes et la messagerie.
      allow update: if estCoach()
        && champs().hasOnly(['statut', 'seancesRestantes', 'updatedAt',
             'dernierMessage', 'dernierMessageLe', 'nonLusCoach', 'nonLus'])
        && request.resource.data.statut in ['demande', 'actif', 'en_pause', 'termine']
        && request.resource.data.get('seancesRestantes', 0) is int
        && request.resource.data.get('seancesRestantes', 0) >= 0;

      allow delete: if estCoach();

      // ----- Exercices -----
      function membre() {
        return connecte()
          && moi() in get(/databases/$(database)/documents/accompagnements/$(id)).data.membres;
      }

      match /exercices/{exerciceId} {
        allow read: if estCoach() || membre();

        allow create, update: if estCoach()
          && request.resource.data.keys().hasOnly([
            'titre', 'consignes', 'contenuId', 'mode', 'echeance', 'repondu',
            'statut', 'createdAt'])
          && texte(request.resource.data.titre, 150)
          && request.resource.data.consignes is string
          && request.resource.data.consignes.size() <= 10000
          && request.resource.data.mode in ['seul', 'a_deux'];

        // Un membre signale qu'il a répondu (seulement lui) et l'état qui en découle.
        allow update: if membre()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repondu', 'statut'])
          && request.resource.data.repondu.toSet().difference(resource.data.repondu.toSet()).hasOnly([moi()])
          && resource.data.repondu.toSet().difference(request.resource.data.repondu.toSet()).size() == 0
          && request.resource.data.statut in ['a_faire', 'fait'];

        allow delete: if estCoach();

        // Réponses : chacun la sienne ; la réponse commune pour les deux.
        // Le coach lit tout.
        match /reponses/{cle} {
          function exercice() {
            return get(/databases/$(database)/documents/accompagnements/$(id)/exercices/$(exerciceId)).data;
          }

          allow read: if estCoach()
            || (connecte() && cle == moi())
            || (cle == 'couple' && membre());

          allow create, update: if membre()
            && ((exercice().mode == 'seul' && cle == moi())
              || (exercice().mode == 'a_deux' && cle == 'couple'))
            && request.resource.data.keys().hasOnly(['texte', 'auteur', 'updatedAt'])
            && request.resource.data.auteur == moi()
            && request.resource.data.texte is string
            && request.resource.data.texte.size() <= 10000;
        }
      }

      // Messages : le coach et les membres, chacun en son nom.
      match /messages/{messageId} {
        allow read: if estCoach() || membre();
        allow create: if (estCoach() || membre())
          && request.resource.data.auteur == moi()
          && request.resource.data.keys().hasOnly([
            'auteur', 'texte', 'photoUrl', 'audioUrl', 'createdAt'])
          && request.resource.data.texte is string
          && request.resource.data.texte.size() <= 5000
          && (request.resource.data.texte.size() > 0
            || 'photoUrl' in request.resource.data
            || 'audioUrl' in request.resource.data);
      }

      // Rendez-vous : le coach les planifie ; les membres les lisent.
      // Les rappels (rappelVeille, rappelHeure) sont cochés par le serveur.
      match /rendezVous/{rdvId} {
        allow read: if estCoach() || membre();
        allow create, update: if estCoach()
          && request.resource.data.keys().hasOnly([
            'nom', 'debut', 'dureeMin', 'lienZoom', 'statut',
            'rappelVeille', 'rappelHeure', 'createdAt', 'updatedAt'])
          && request.resource.data.debut is timestamp
          && request.resource.data.dureeMin is int
          && request.resource.data.dureeMin >= 15
          && request.resource.data.dureeMin <= 240
          && request.resource.data.lienZoom is string
          && request.resource.data.lienZoom.size() <= 500
          && (request.resource.data.lienZoom == ''
            || request.resource.data.lienZoom.matches('https://[^ ]+'))
          && request.resource.data.statut in ['prevu', 'fait', 'annule'];
        allow delete: if estCoach();
      }

      // Notes privées : le coach seulement.
      match /notes/{noteId} {
        allow read, delete: if estCoach();
        allow create, update: if estCoach()
          && request.resource.data.keys().hasOnly(['texte', 'createdAt', 'updatedAt'])
          && texte(request.resource.data.texte, 10000);
      }
    }

    // Agenda du coach : tous les rendez-vous (requête de groupe).
    match /{chemin=**}/rendezVous/{rdvId} {
      allow read: if estCoach();
    }

    // ----- Contenus du coach -----
    // Publiés : publics pour tous, les autres pour les personnes connectées.
    // Brouillons : le coach seulement. Écriture : le coach seulement.
    function langues(m) {
      return m is map && m.keys().hasOnly(['fr', 'en', 'pt', 'es', 'nl']);
    }

    match /contenus/{id} {
      allow read: if estCoach()
        || (resource.data.publie == true
          && (resource.data.visibilite == 'public' || connecte()));

      allow create, update: if estCoach()
        && request.resource.data.keys().hasOnly([
          'type', 'theme', 'titre', 'texte', 'medias', 'reference', 'visibilite',
          'publie', 'ordre', 'createdAt', 'updatedAt'])
        && request.resource.data.type in ['meditation', 'question', 'exercice', 'article', 'audio', 'video']
        && (!('medias' in request.resource.data) || langues(request.resource.data.medias))
        && request.resource.data.visibilite in ['public', 'connectes']
        && request.resource.data.publie is bool
        && langues(request.resource.data.titre)
        && langues(request.resource.data.texte)
        && texte(request.resource.data.titre.fr, 150);

      allow delete: if estCoach();
    }

    // ----- Parcours -----
    match /parcours/{id} {
      allow read: if estCoach()
        || (resource.data.publie == true
          && (resource.data.visibilite == 'public' || connecte()));

      allow create, update: if estCoach()
        && request.resource.data.keys().hasOnly([
          'titre', 'description', 'etapes', 'visibilite', 'publie', 'ordre',
          'createdAt', 'updatedAt'])
        && langues(request.resource.data.titre)
        && langues(request.resource.data.description)
        && texte(request.resource.data.titre.fr, 150)
        && request.resource.data.etapes is list
        && request.resource.data.etapes.size() <= 200
        && request.resource.data.visibilite in ['public', 'connectes']
        && request.resource.data.publie is bool;

      allow delete: if estCoach();
    }

    // Codes d'invitation : lisibles un par un (jamais listés) par qui connaît
    // le code ; créés avec leur accompagnement.
    match /invitations/{code} {
      allow get: if connecte();
      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['accompagnementId', 'createdAt'])
        && getAfter(/databases/$(database)/documents/accompagnements/$(request.resource.data.accompagnementId))
             .data.membres == [moi()];
      allow delete: if estCoach();
    }
  }
}
