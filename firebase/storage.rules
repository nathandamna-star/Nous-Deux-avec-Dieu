rules_version = '2';

// Fichiers audio et vidéo des contenus. Envoi : le coach seulement.
// Lecture : par l'adresse de téléchargement (jeton secret), donc seulement pour
// qui a pu lire le contenu dans Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function estCoach() {
      return request.auth != null && request.auth.token.coach == true;
    }

    // Photo de profil : chacun la sienne, image de moins de 5 Mo.
    match /users/{uid}/{fichier} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photos et messages vocaux d'une conversation : le coach et les membres.
    function membreConversation(accId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/accompagnements/$(accId)).data.membres;
    }

    match /messages/{accId}/{fichier} {
      allow read: if estCoach() || membreConversation(accId);
      allow create: if (estCoach() || membreConversation(accId))
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 20 * 1024 * 1024));
    }

    // Couvertures des livres : publiques (page du livre visible sans compte).
    match /livres/{livreId}/{fichier} {
      allow read: if true;
      allow create, update: if estCoach()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if estCoach();
    }

    match /contenus/{contenuId}/{fichier} {
      allow read: if request.auth != null;
      allow create, update: if estCoach()
        && ((request.resource.contentType.matches('audio/.*')
              && request.resource.size < 200 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
              && request.resource.size < 1024 * 1024 * 1024));
      allow delete: if estCoach();
    }
  }
}
